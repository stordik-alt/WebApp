# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenRouter AI (má přednost před Lovable, pokud je nastaveno)
OPENROUTER_API_KEY=your_openrouter_api_key
# volitelné – výchozí je vision model qwen/qwen3-vl-8b-instruct (OCR obrázků),
# silnější varianta: qwen/qwen3-vl-235b-a22b-instruct
# OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct

# Lovable API
LOVABLE_API_KEY=your_lovable_api_key
